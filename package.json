{
  "name": "yuekebao-grabber",
  "version": "1.0.0",
  "description": "A Playwright MCP server to scrape yuekebao.cn homepage content",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node run-test.js",
    "serve": "node dashboard-start.js",
    "dashboard": "node dashboard-start.js",
    "dashboard-dev": "node --watch dashboard-start.js",
    "dashboard-http": "HTTPS=false node dashboard-start.js",
    "dashboard-https": "node dashboard-start.js",
    "scraper": "node local-scraper.js",
    "scraper-dev": "node --watch local-scraper.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.1.1",
    "mysql2": "^3.15.0",
    "playwright": "^1.40.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "playwright",
    "mcp",
    "scraping",
    "yuekebao"
  ],
  "author": "",
  "license": "MIT"
}
